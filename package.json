{
	"name": "drizzle-chunked-insert",
	"version": "0.1.1",
	"description": "Insert any number of rows with Drizzle ORM: splits them into statements that fit each driver's bound-parameter limit (D1, SQLite, Postgres, MySQL) and writes them all or none",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/drizzle-chunked-insert.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"bench": "node bench/insert.bench.ts",
		"test": "node --test \"test/**/*.test.ts\"",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"drizzle",
		"drizzle-orm",
		"insert",
		"bulk-insert",
		"batch",
		"chunk",
		"d1",
		"sqlite",
		"postgres",
		"mysql",
		"too-many-sql-variables"
	],
	"peerDependencies": {
		"drizzle-orm": ">=0.36.4"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@libsql/client": "^0.18.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"better-sqlite3": "^13.1.1",
		"drizzle-orm": "0.45.4",
		"miniflare": "^4.20260730.0",
		"mysql2": "^3.24.6",
		"pg": "^8.23.1",
		"postgres": "^4.1.1",
		"typescript": "^7.0.2"
	}
}
